{
 "name": "kakeibo",
 "version": "1.0.0",
 "private": true,
 "type": "module",
 "scripts": {
  "dev": "vite",
  "predev:api": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\"",
  "dev:api": "wrangler dev",
  "build": "vite build",
  "typecheck": "tsc -b",
  "vapid": "node scripts/gen-vapid.mjs",
  "deploy:dev": "npm run build && wrangler deploy --env dev",
  "deploy:prod": "npm run build && wrangler deploy --env production",
  "logs:dev": "wrangler tail --env dev",
  "logs:prod": "wrangler tail --env production",
  "db:migrate": "wrangler d1 migrations apply DB --local",
  "db:init": "npm run db:migrate",
  "db:migrate:dev": "wrangler d1 migrations apply DB --remote --env dev",
  "db:migrate:prod": "wrangler d1 migrations apply DB --remote --env production",
  "admin:setup": "node scripts/admin-setup.mjs",
  "test": "node scripts/test-api.mjs"
 },
 "dependencies": {
  "@block65/webcrypto-web-push": "^2.0.0",
  "@tanstack/react-query": "^5.60.0",
  "chart.js": "^4.4.0",
  "dexie": "^4.4.6",
  "dexie-react-hooks": "^4.4.0",
  "hono": "^4.6.0",
  "jsqr": "^1.4.0",
  "qrcode": "^1.5.4",
  "react": "^18.3.1",
  "react-chartjs-2": "^5.2.0",
  "react-dom": "^18.3.1",
  "react-router-dom": "^6.28.0",
  "workbox-cacheable-response": "^7.4.1",
  "workbox-expiration": "^7.4.1",
  "workbox-precaching": "^7.4.1",
  "workbox-routing": "^7.4.1",
  "workbox-strategies": "^7.4.1"
 },
 "devDependencies": {
  "@cloudflare/workers-types": "^5.20261001.1",
  "@types/qrcode": "^1.5.6",
  "@types/react": "^18.3.0",
  "@types/react-dom": "^18.3.0",
  "@vitejs/plugin-react": "^4.3.0",
  "typescript": "^5.6.0",
  "vite": "^5.4.0",
  "vite-plugin-pwa": "^0.20.0",
  "wrangler": "^4.0.0",
  "tsx": "^4.19.0",
  "fake-indexeddb": "^6.0.0"
 }
}